DATABASE_URL="postgresql://devport:devport@localhost:5432/devport"

BETTER_AUTH_SECRET="replace-with-at-least-32-characters-secret"
# Origin the browser uses for auth (user app when Next proxies /api to the backend). Not the backend port alone.
BETTER_AUTH_URL="http://localhost:3000"

# Frontend origins, used for CORS and Better Auth trusted origins.
APP_URL="http://localhost:3000"
DASHBOARD_URL="http://localhost:3003"
PORTFOLIO_URL="http://localhost:3002"
WEBSITE_URL="http://localhost:3004"

# Optional OAuth providers (each enabled only when both values are set).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email OTP via Resend (https://resend.com). When unset, codes are printed to the backend console.
RESEND_API_KEY=""
# Sender on a domain verified in Resend, e.g. "DevPort <no-reply@example.com>".
EMAIL_FROM=""

# Optional Hetzner Object Storage for uploads (uploads return 503 when unset).
# The bucket must be public so uploaded images/PDFs can be displayed.
HETZNER_S3_ACCESS_KEY=""
HETZNER_S3_SECRET_KEY=""
HETZNER_S3_BUCKET=""
# Bucket location: fsn1, nbg1, or hel1.
HETZNER_S3_LOCATION="fsn1"

# Optional GitHub token (no scopes needed) for fetching users' public repos.
# Raises the GitHub API limit from 60 to 5,000 requests/hour for the backend's IP.
GITHUB_API_KEY=""
