{
  "name": "devport",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "bun run --filter @devport/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "bun@1.2.9"
}
